# OpenTelemetry Configuration
# ===========================

# Exporter type: 'console' for development, 'otlp' for SigNoz/collectors
VITE_OTEL_EXPORTER=console

# OTLP collector endpoint (used when VITE_OTEL_EXPORTER=otlp)
VITE_OTEL_ENDPOINT=http://localhost:4318

# Trace sampling rate (0.0 to 1.0, default: 1.0 = 100%)
VITE_OTEL_SAMPLE_RATE=1.0

# Service name for telemetry attribution
VITE_SERVICE_NAME=agent-sandbox-frontend

# Backend URL for trace context propagation
VITE_BACKEND_URL=http://localhost:8888
