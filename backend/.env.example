# Development mode - set to true to use mock LLM
USE_MOCK_LLM=false

# Azure OpenAI Configuration (required when USE_MOCK_LLM=false)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# OpenTelemetry Configuration
# ===========================

# Enable Agent Framework instrumentation for traces, logs, metrics
ENABLE_INSTRUMENTATION=true

# OTLP exporter protocol: 'http/protobuf' for HTTP, 'grpc' for gRPC
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Signal-specific OTLP endpoints (HTTP exporters need full paths)
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics

# Service name for telemetry attribution
OTEL_SERVICE_NAME=agent-sandbox-server
